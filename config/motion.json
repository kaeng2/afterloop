{
  "version": 1,
  "source": "시안 docs/design/mockup-v4/Desk.dc.html의 transition·animation 값 그대로 (SPEC v2.15 8-4장). prefers-reduced-motion이면 모두 끈다.",
  "desk": {
    "hover": { "duration": "0.15s", "easing": "ease", "from": ".btn·.it transition:background-color .15s" },
    "choiceCard": { "duration": "0.15s", "easing": "ease", "from": ".npath transition:border-color .15s,background-color .15s" },
    "curve": { "duration": "0.3s", "easing": "ease", "from": "곡선 점선 polyline style transition:all .3s ease" },
    "ping": {
      "duration": "1.4s",
      "easing": "ease-out",
      "fromRadius": 7,
      "toRadius": 20,
      "fromOpacity": 0.6,
      "from": "@keyframes ping{0%{r:7;opacity:.6}100%{r:20;opacity:0}} .ping{animation:ping 1.4s ease-out infinite}"
    },
    "reactionBar": { "duration": "0.35s", "easing": "ease", "from": "반응 막대 transition:width .35s ease" },
    "editorBorder": { "duration": "0.3s", "easing": "ease", "from": ".editor transition:border-color .3s ease, 알약 background-color .3s ease" }
  }
}
