{
  "name": "afterloop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run tests/unit tests/integration",
    "test:acceptance": "vitest run tests/acceptance",
    "test:watch": "vitest tests/unit tests/integration",
    "test:sandbox": "node -e \"if(process.env.RUN_SANDBOX!=='1'){console.log('RUN_SANDBOX=1 일 때만 실행합니다.');process.exit(0)}\" && vitest run tests/sandbox",
    "sandbox:check": "tsx scripts/sandbox/check.ts",
    "sandbox:setup": "tsx scripts/sandbox/setup.ts",
    "sandbox:disputes": "tsx scripts/sandbox/disputes.ts",
    "sandbox:orders": "tsx scripts/create-sandbox-orders.ts",
    "sandbox:capture": "tsx scripts/capture-sandbox-orders.ts",
    "eval:classifier": "tsx scripts/eval-classifier.ts",
    "seed": "tsx seed/generate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
