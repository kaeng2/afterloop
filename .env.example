# PayPal 샌드박스 REST 앱의 Client ID (developer.paypal.com → Apps & Credentials → Sandbox → 앱)
PAYPAL_CLIENT_ID=
# 같은 앱의 Secret. 사람이 직접 입력한다 (AI는 읽지 않는다). .env는 커밋하지 않는다.
PAYPAL_CLIENT_SECRET=
# 샌드박스만 쓴다: https://api-m.sandbox.paypal.com (live 주소를 넣으면 스크립트가 호출하지 않고 멈춘다)
PAYPAL_BASE_URL=
# 문구 생성·분류에 쓰는 LLM 키 (제공자 콘솔에서 받는다)
LLM_API_KEY=

# 추적번호 등록 (T011, SPEC 9-3). 기본은 꺼짐 = dry run (PayPal 호출 0회).
# 켜도 AFTERLOOP_TRACK_LIVE_ORDERS에 있는 주문만 호출한다 (기본 O03). O05·O07은 녹화 때만: AFTERLOOP_TRACK_RECORDING=1
AFTERLOOP_TRACK_LIVE=
AFTERLOOP_TRACK_LIVE_ORDERS=
AFTERLOOP_TRACK_RECORDING=
