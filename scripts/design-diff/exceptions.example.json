      "match": { "kind": "extra", "text": "Demo data" }
    },
    {
      "id": "EX-03",
      "reason": "예: AG Grid 표는 라이브러리 기본 스타일",
      "match": { "kind": "style", "selector": ".ag-root-wrapper", "prop": ["font-family", "line-height"] }
